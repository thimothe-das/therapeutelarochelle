# Copier en .env.local pour le developpement.
# NEXT_PUBLIC_API_URL est publique par construction (Next l'inscrit dans le
# JavaScript livre au navigateur). REVALIDATE_SECRET_KEY est secrete : la
# valeur de prod vit dans le Secret chiffre de homelab-infra et dans les
# reglages de l'extension WordPress On-Demand Revalidation, nulle part ailleurs.
NEXT_PUBLIC_API_URL=https://administration.therapeutelarochelle.fr/wp-json/wp/v2
REVALIDATE_SECRET_KEY=
